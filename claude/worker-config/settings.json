{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config",
        "~/.docker",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.git-credentials",
        "~/.zsh_history",
        "~/.bash_history",
        "~/.claude",
        "~/Library/Keychains",
        "~/Library/Application Support",
        "~/Library/Cookies",
        "~/Library/Containers"
      ]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(node --test:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/.*-key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/**)",
      "Read(~/Library/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(security:*)",
      "Read(~/.bash_history)",
      "Read(~/.claude-worker/**)",
      "Read(~/.config/**)",
      "Read(~/.docker/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.zsh_history)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/.envrc)",
      "Write(**/.envrc)",
      "Edit(**/.vscode/**)",
      "Write(**/.vscode/**)",
      "Edit(**/.husky/**)",
      "Write(**/.husky/**)",
      "Edit(~/.claude-worker/**)",
      "Write(~/.claude-worker/**)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
